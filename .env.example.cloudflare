# Cloudflare Pages deploy creds — copy to .env and fill in (.env is git-ignored).
# Same convention as roxabi-forge: the Makefile exports these so `wrangler`
# authenticates non-interactively (no `wrangler login` at deploy time).
#
# Token scopes (dash.cloudflare.com/profile/api-tokens):
#   Account → Cloudflare Pages   : Edit
#   Account → Account Settings   : Read
#   User    → User Details       : Read
# Account ID: Cloudflare dashboard → any domain → right sidebar → Account ID.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
